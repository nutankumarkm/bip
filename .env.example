# BIP Environment Configuration
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql+asyncpg://bip_owner:changeme@localhost:5432/bip
DATABASE_URL_SYNC=postgresql://bip_owner:changeme@localhost:5432/bip
POSTGRES_USER=bip_owner
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bip

# Encryption
BIP_MASTER_KEY=base64-encoded-32-byte-key-for-dev-only

# JWT
BIP_JWT_SECRET=change-this-in-production

# Edge
BIP_EDGE_HOST=0.0.0.0
BIP_EDGE_PORT=8081

# API
BIP_API_HOST=0.0.0.0
BIP_API_PORT=8080

# Logging
BIP_LOG_LEVEL=INFO
BIP_LOG_FORMAT=json

# Gateway updater (public key for verifying signed manifests)
BIP_GATEWAY_UPDATE_PUBKEY=
